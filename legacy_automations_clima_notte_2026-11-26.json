    "automation.clima_backup_via_quando_esco": {"id":"1781512382805","alias":"Clima - Backup Via quando esco","description":"Rete di sicurezza: passa a Via SOLO se né Mattia né Valentina (person.mattia_pontacolone + person.ehi, aggregati in group.presenza_adulti) sono a casa per 18 ore continuative. Il timer riparte da quando esce l'ultimo e si azzera se uno rientra → non scatta per le uscite brevi (pranzo e rientro nel pomeriggio). Non rimette mai Casa: il rientro lo gestisci a mano / con Apri Casa.","triggers":[{"trigger":"state","entity_id":"group.presenza_adulti","to":"not_home","for":"18:00:00"}],"conditions":[{"condition":"state","entity_id":"input_select.modalita_casa","state":["Casa","Notte"]}],"actions":[{"action":"input_select.select_option","target":{"entity_id":"input_select.modalita_casa"},"data":{"option":"Via"}}],"mode":"single"},
    "automation.clima_rientro_in_casa_ripristina_fancoil": {"id":"1781530239918","alias":"Clima - Rientro in Casa: ripristina fancoil","description":"Quando Modalità passa a Casa: ferma la notte silenziosa, rimette tutti gli 8 fancoil in AUTO e dà un impulso ON così la centralina riprende (riaccende solo quelli che servono, rispegne gli altri). Chiude il buco del 'ritorno' dopo notte/standby.","triggers":[{"trigger":"state","entity_id":"input_select.modalita_casa","to":"Casa"}],"conditions":[],"actions":[{"action":"input_boolean.turn_off","target":{"entity_id":["input_boolean.notte_silenziosa_padronale","input_boolean.notte_silenziosa_ospiti","input_boolean.notte_silenziosa_gabriele"]}},{"action":"switch.turn_off","target":{"entity_id":["switch.fancoil_salotto_manuale","switch.fancoil_cucina_manuale","switch.fancoil_locale_rack_manuale","switch.fancoil_sala_giochi_manuale","switch.fancoil_camera_padronale_manuale","switch.fancoil_camera_ospiti_manuale","switch.fancoil_camera_gabriele_manuale"]}},{"delay":{"seconds":2}},{"action":"fan.turn_on","target":{"entity_id":["fan.fancoil_salotto","fan.fancoil_cucina","fan.fancoil_locale_rack","fan.fancoil_sala_giochi","fan.fancoil_camera_padronale","fan.fancoil_camera_ospiti","fan.fancoil_camera_gabriele"]}},{"action":"switch.turn_on","target":{"entity_id":"switch.fancoil_studio_pianerottolo_p1_manuale"},"enabled":false},{"action":"fan.turn_off","target":{"entity_id":"fan.fancoil_studio_pianerottolo_p1"},"enabled":false}],"mode":"single"},
    "automation.clima_risincronizza_modalita_all_avvio": {"id":"1781872964099","alias":"Clima - Risincronizza modalità all'avvio","description":"Dopo un riavvio di HA: attende 60s che il KNX si connetta, poi ri-applica i preset sui termostati secondo la Modalità ripristinata (l'input_select ora ricorda l'ultima modalità, niente initial forzato). Risolve il disallineamento selettore↔termostati visto il 18/6.","triggers":[{"trigger":"homeassistant","event":"start"}],"conditions":[],"actions":[{"delay":{"seconds":60}},{"action":"automation.trigger","target":{"entity_id":"automation.clima_applica_modalita_casa"}}],"mode":"single"}
