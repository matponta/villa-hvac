  "automations": {
    "automation.clima_applica_modalita_casa": {"id":"1781512360342","alias":"Clima - Applica Modalità Casa","description":"Imposta il preset KNX (comfort/economy/standby/building_protection) su tutti i 17 termostati in base a input_select.modalita_casa.","triggers":[{"trigger":"state","entity_id":"input_select.modalita_casa"}],"conditions":[],"actions":[{"choose":[{"conditions":[{"condition":"state","entity_id":"input_select.modalita_casa","state":"Casa"}],"sequence":[{"action":"climate.set_preset_mode","target":{"entity_id":["climate.ingresso_termostato_2","climate.palestra_termostato_2","climate.bagno_palestra_termostato_2","climate.studio_termostato_2","climate.pianerottolo_p1_termostato_2","climate.bagno_giochi_termostato_2","climate.sala_giochi_termostato_2","climate.salotto_termostato_2","climate.bagno_ingresso_termostato_2","climate.camera_padronale_termostato_2","climate.bagno_padronale_01_termostato_2","climate.bagno_padronale_02_termostato_2","climate.studio_v_termostato_2","climate.pianerottolo_p2_termostato_2","climate.lavanderia_termostato_2","climate.bagno_gabriele_termostato_2","climate.camera_gabriele_termostato_2"]},"data":{"preset_mode":"comfort"}}]},{"conditions":[{"condition":"state","entity_id":"input_select.modalita_casa","state":"Notte"}],"sequence":[{"action":"climate.set_preset_mode","target":{"entity_id":["climate.ingresso_termostato_2","climate.palestra_termostato_2","climate.bagno_palestra_termostato_2","climate.studio_termostato_2","climate.pianerottolo_p1_termostato_2","climate.bagno_giochi_termostato_2","climate.sala_giochi_termostato_2","climate.salotto_termostato_2","climate.bagno_ingresso_termostato_2","climate.camera_padronale_termostato_2","climate.bagno_padronale_01_termostato_2","climate.bagno_padronale_02_termostato_2","climate.studio_v_termostato_2","climate.pianerottolo_p2_termostato_2","climate.lavanderia_termostato_2","climate.bagno_gabriele_termostato_2","climate.camera_gabriele_termostato_2"]},"data":{"preset_mode":"econo